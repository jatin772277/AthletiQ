# AthletiQ Environment Configuration

# Groq API key (free tier: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Backend Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=true
APP_ENV=development

# MongoDB: MONGO_URI is required in production. MONGODB_URI is retained for local compatibility.
MONGODB_URI=mongodb://localhost:27017
# MONGO_URI=mongodb://localhost:27017/athletiq
MONGODB_DB=athletiq

# Comma-separated browser origins. Omit locally to use the localhost Vite/API origins.
# CORS_ORIGINS=https://app.example.com
# Build-time frontend API origin. Required when APP_ENV=production.
# VITE_API_BASE=https://api.example.com

# Session signing key. If unset, one is generated and stored in backend/.jwt_secret
JWT_SECRET=change_me_to_a_long_random_string
SESSION_TTL_HOURS=72

# Gmail SMTP for password-reset emails. Create a Google App Password at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
# Never use your regular Gmail password here.
GMAIL_SMTP_EMAIL=jatinbaghel284@gmail.com
GMAIL_SMTP_APP_PASSWORD=mekezejtoagdstdl
GMAIL_FROM_NAME=AthletiQ

# Pipeline execution for uploaded videos
# wsl   = run AthletiQ.py inside WSL with the GPU venv below (recommended on this machine)
# local = run it with PIPELINE_PYTHON (defaults to the backend's Python) on CPU
PIPELINE_MODE=wsl
PIPELINE_WSL_VENV=~/tf312
PIPELINE_DEVICE=0
# Linux CPU EC2 example: PIPELINE_MODE=local and PIPELINE_DEVICE=cpu
PIPELINE_MAX_FRAMES=750
MAX_UPLOAD_MB=2048

# Optional persistent-data mount. Individual paths override this root.
# ATHLETIQ_DATA_DIR=/srv/athletiq-data
# MODEL_ASSETS_DIR=/srv/athletiq-data/models
# UPLOADS_DIR=/srv/athletiq-data/uploads
# OUTPUTS_DIR=/srv/athletiq-data/outputs

# Pre-computed matches every signed-in user can browse (comma-separated)
DEMO_MATCHES=football4
